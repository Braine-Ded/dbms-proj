# Mock project: every password here is plaintext on purpose.
# run.sh reads this file. Go's server reads it too when started without run.sh.

# MySQL server
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
PORT=8080

# root login, only used by `./run.sh --reset` to rebuild the database and accounts
MYSQL_USER=root
MYSQL_PASSWORD=root

# Website accounts (MySQL users created by db/04_users.sql).
# Sign in on the website with one of these. If you change a password,
# change it in db/04_users.sql too and run ./run.sh --reset.
ADMIN_USER=ft_admin
ADMIN_PASSWORD=admin123
CLERK_USER=ft_clerk
CLERK_PASSWORD=clerk123
VIEWER_USER=ft_viewer
VIEWER_PASSWORD=viewer123
