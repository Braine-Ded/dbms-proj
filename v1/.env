# Stride v1 settings. Mock project: every secret is kept here in plaintext on purpose.
# A variable already set in the shell wins over this file.

# MySQL / MariaDB server and the database the site uses
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fitness_tracker_v1

# MySQL account Django connects as (created by db/00_account.sql)
DB_USER=stride_app
DB_PASSWORD=stride_app_pass

# Django
PORT=8000
DEBUG=true
SECRET_KEY=stride-v1-plaintext-secret-key-change-me-0f3a9c1e7b
TIME_ZONE=Asia/Kolkata

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Logins created by db/02_seed.sql (the hashes in that file are of these passwords)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_USER_PASSWORD=stride12345
